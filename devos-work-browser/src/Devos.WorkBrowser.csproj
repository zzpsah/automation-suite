<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DEVOS.WorkBrowser</AssemblyName>
    <RootNamespace>Devos.WorkBrowser</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\test-portal\index.html" Link="test-portal\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    WebView2Loader.dll is native and architecture-specific. In some dotnet publish
    layouts the WebView2 SDK targets do not surface the loader in the publish root,
    which can leave the WPF shell running while WebView2 silently fails to initialize
    on user machines. Force the x64 loader into the distributable root and fail the
    publish if the NuGet package layout cannot be resolved.
  -->
  <Target Name="ResolveDevosWebView2Loader" BeforeTargets="Publish">
    <PropertyGroup>
      <_DevosWebView2Loader Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')">$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll</_DevosWebView2Loader>
      <_DevosWebView2Loader Condition="'$(_DevosWebView2Loader)' == '' and Exists('$(PkgMicrosoft_Web_WebView2)\build\native\x64\WebView2Loader.dll')">$(PkgMicrosoft_Web_WebView2)\build\native\x64\WebView2Loader.dll</_DevosWebView2Loader>
    </PropertyGroup>
    <Error Condition="'$(_DevosWebView2Loader)' == ''" Text="Could not locate x64 WebView2Loader.dll inside Microsoft.Web.WebView2 NuGet package." />
  </Target>

  <Target Name="CopyDevosWebView2Loader" AfterTargets="Publish" DependsOnTargets="ResolveDevosWebView2Loader">
    <Copy SourceFiles="$(_DevosWebView2Loader)" DestinationFiles="$(PublishDir)WebView2Loader.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
