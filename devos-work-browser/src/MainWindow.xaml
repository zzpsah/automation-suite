<Window x:Class="Devos.WorkBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEVOS Work Browser"
        AutomationProperties.AutomationId="MainWindow"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" AutomationProperties.AutomationId="BackButton" Grid.Column="0" Width="38" Height="34" Margin="0,0,6,0" Content="←" Click="Back_Click" />
                <Button x:Name="ForwardButton" AutomationProperties.AutomationId="ForwardButton" Grid.Column="1" Width="38" Height="34" Margin="0,0,6,0" Content="→" Click="Forward_Click" />
                <Button AutomationProperties.AutomationId="ReloadButton" Grid.Column="2" Width="38" Height="34" Margin="0,0,6,0" Content="⟳" Click="Reload_Click" />
                <Button AutomationProperties.AutomationId="HomeButton" Grid.Column="3" Width="48" Height="34" Margin="0,0,8,0" Content="Home" Click="Home_Click" />
                <TextBox x:Name="AddressBox" AutomationProperties.AutomationId="AddressBox" Grid.Column="4" Height="34" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" KeyDown="AddressBox_KeyDown" />
                <Button AutomationProperties.AutomationId="GoButton" Grid.Column="5" Width="58" Height="34" Margin="8,0,0,0" Content="Go" Click="Go_Click" />
                <Button AutomationProperties.AutomationId="NewTabButton" Grid.Column="6" Width="72" Height="34" Margin="8,0,0,0" Content="+ Tab" Click="NewTab_Click" />
                <Button AutomationProperties.AutomationId="CloseTabButton" Grid.Column="7" Width="72" Height="34" Margin="8,0,0,0" Content="× Tab" Click="CloseTab_Click" />
                <Button AutomationProperties.AutomationId="TestPortalButton" Grid.Column="8" Width="92" Height="34" Margin="8,0,0,0" Content="Test Portal" Click="TestPortal_Click" />
            </Grid>

            <Border Margin="10,0,10,8" Padding="8" BorderThickness="1" BorderBrush="#D6D6D6" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox"
                             AutomationProperties.AutomationId="CommandBox"
                             Grid.Column="0"
                             Height="34"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             ToolTip="DEVOS command. Ctrl+Space focuses here. Use semicolons for bounded sequences. Acceptance command: process synthetic portal" />
                    <Button x:Name="RunCommandButton"
                            AutomationProperties.AutomationId="RunCommandButton"
                            Grid.Column="1"
                            Width="88"
                            Height="34"
                            Margin="8,0,0,0"
                            Content="Run"
                            Click="RunCommand_Click" />
                    <TextBlock x:Name="CommandStatus"
                               AutomationProperties.AutomationId="CommandStatus"
                               Grid.Column="2"
                               MinWidth="210"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Ready" />
                </Grid>
            </Border>
        </StackPanel>
        <TabControl x:Name="BrowserTabs" AutomationProperties.AutomationId="BrowserTabs" SelectionChanged="BrowserTabs_SelectionChanged" />
    </DockPanel>
</Window>
