# Public portal values only
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Never put server secrets in a public frontend.
# Configure these in Apps Script Properties instead:
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
# AUTHORIZED_TELEGRAM_USER_IDS
# AUTHORIZED_TELEGRAM_CHAT_IDS
# DRIVE_INBOX_FOLDER_ID
# DRIVE_PROCESSING_FOLDER_ID
# DRIVE_REVIEWED_FOLDER_ID
# SUPABASE_URL
# SUPABASE_SERVER_SECRET
# EXTRACTION_MODE=MANUAL_ONLY
# DRIVE_SCAN_BATCH_SIZE=10
