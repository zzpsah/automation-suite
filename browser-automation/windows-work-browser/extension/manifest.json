{
  "manifest_version": 3,
  "name": "Windows Work Browser",
  "version": "0.1.0",
  "description": "Automation-first work panel for Windows Work Browser.",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "downloads", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Windows Work Browser" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
