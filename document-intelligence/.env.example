# Vercel/server-side app secrets
APP_PASSWORD=change-me
AUTH_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET
R2_BUCKET=documents

# Optional AI enrichment. Leave unset for deterministic-only processing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Worker uses the same Supabase/R2 variables as GitHub Actions secrets:
# DI_SUPABASE_URL
# DI_SUPABASE_SERVICE_ROLE_KEY
# DI_R2_ACCOUNT_ID
# DI_R2_ACCESS_KEY_ID
# DI_R2_SECRET_ACCESS_KEY
# DI_R2_BUCKET
# DI_GEMINI_API_KEY (optional)
